# SplitShield backend configuration (all optional; defaults shown)
# No secrets are required to run SplitShield.

# Where uploads, extracted data and the SQLite DB live
SPLITSHIELD_DATA_DIR=/tmp/splitshield-data

# Upload limits
SPLITSHIELD_MAX_UPLOAD_BYTES=536870912
SPLITSHIELD_MAX_UNCOMPRESSED_BYTES=2147483648
SPLITSHIELD_MAX_FILE_COUNT=50000

# Data retention (hours) before automatic deletion
SPLITSHIELD_RETENTION_HOURS=24

# Analysis defaults
SPLITSHIELD_PHASH_THRESHOLD=8
SPLITSHIELD_PHASH_STRONG_THRESHOLD=4
SPLITSHIELD_SEMANTIC_THRESHOLD=0.90

# Embedding backend: auto | torch | classical | off
SPLITSHIELD_EMBEDDING_BACKEND=auto

# CORS origins for the frontend, comma-separated
SPLITSHIELD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
